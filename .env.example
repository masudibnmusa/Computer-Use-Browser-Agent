ANTHROPIC_API_KEY=sk-ant-...
BA_LLM_MODEL=claude-sonnet-5-5
BA_HEADLESS=true
BA_MAX_STEPS=40
BA_MAX_COST_USD=2.0
# comma-separated; empty = allow all domains
BA_ALLOWED_DOMAINS=
# ask | deny | auto
BA_APPROVAL_MODE=ask
# secrets the LLM can reference as {{secret:SHOP_PASSWORD}} but never sees:
# BA_SECRET_SHOP_PASSWORD=...